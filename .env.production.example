# Server-only AI provider credentials. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
HF_CREDENTIALS=

# Optional model overrides.
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-opus-5

# Safety defaults. The application still requires per-request explicit confirmation
# before any real provider or publishing call.
FACTORY_REAL_EXECUTION_ENABLED=false
FACTORY_REAL_PUBLISH_ENABLED=false
