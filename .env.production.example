# Server-only AI provider credentials. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Higgsfield REST/API credentials (official key pair)
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Optional combined SDK credential form
HF_CREDENTIALS=

# Optional model overrides.
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-opus-5

# Safety defaults. The application still requires per-request explicit confirmation
# before any real provider or publishing call.
FACTORY_REAL_EXECUTION_ENABLED=false
FACTORY_REAL_PUBLISH_ENABLED=false

# Keep local runtime mutation endpoints disabled on hosted deployments.
FACTORY_ALLOW_REMOTE_MUTATIONS=false
