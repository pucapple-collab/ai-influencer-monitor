<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: transparent;
      user-select: none;
      -webkit-user-select: none;
    }

    .widget {
      position: relative;
      width: 100%;
      height: 100%;
    }

    /*
      창 이동 전용 영역
      캐릭터가 없는 투명 영역을 잡아 창을 이동한다.
    */
    .drag-area {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 90px;

      -webkit-app-region: drag;
      cursor: move;

      z-index: 1;
    }

    .bubble {
      position: absolute;
      top: 8px;
      left: 12px;
      right: 12px;

      padding: 12px 15px;
      border-radius: 18px;

      background: rgba(15, 23, 42, 0.95);
      border: 1px solid rgba(255,255,255,0.12);

      color: white;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
      font-size: 13px;
      line-height: 1.45;
      text-align: center;

      box-shadow: 0 10px 30px rgba(0,0,0,0.25);

      z-index: 3;

      -webkit-app-region: no-drag;
    }

    .status {
      color: #34d399;
      font-weight: 800;
      font-size: 11px;
      letter-spacing: .08em;
      margin-bottom: 4px;
    }

    /*
      캐릭터는 완전히 no-drag.
      브라우저의 이미지 기본 드래그도 차단한다.
    */
    @keyframes factoryGuideIdle {
      0%, 100% {
        transform: translateX(-50%) translateY(0);
      }

      50% {
        transform: translateX(-50%) translateY(-5px);
      }
    }

        .character-stage {
      animation: characterIdle 3.2s ease-in-out infinite;
      transform-origin: center bottom;
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 330px;
      z-index: 2;
      pointer-events: none;
    }

.character {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);

      width: 270px;

      z-index: 2;

      -webkit-app-region: no-drag;

      user-select: none;
      -webkit-user-select: none;

      -webkit-user-drag: none;
      user-drag: none;

      pointer-events: auto;

      cursor: pointer;

      filter: drop-shadow(0 12px 20px rgba(0,0,0,.35));
      transform-origin: center bottom;
    }

    .panel {
      display: none;

      position: absolute;
      top: 8px;
      left: 10px;
      right: 10px;

      padding: 15px;

      border-radius: 20px;

      background: rgba(15, 23, 42, 0.98);
      border: 1px solid rgba(255,255,255,.14);

      color: white;

      box-shadow: 0 15px 40px rgba(0,0,0,.35);

      z-index: 10;

      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;

      -webkit-app-region: no-drag;
    }

    .panel.open {
      display: block;
    }

    .panel.open ~ * {
      visibility: hidden;
    }

    .panel.open ~ #character {
      visibility: visible;
    }

    .widget.panel-open .bubble {
      display: none;
    }

    .panel-title {
      font-size: 14px;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .row {
      display: flex;
      justify-content: space-between;
      align-items: center;

      padding: 6px 0;

      font-size: 11px;
    }

    .ready {
      color: #34d399;
      font-weight: 700;
    }

    .next {
      color: #60a5fa;
      font-weight: 700;
    }

    .waiting {
      color: #94a3b8;
      font-weight: 700;
    }

    .close {
      margin-top: 10px;

      width: 100%;
      padding: 7px;

      border: 0;
      border-radius: 10px;

      background: rgba(255,255,255,.08);
      color: #cbd5e1;

      cursor: pointer;

      -webkit-app-region: no-drag;
    }
  </style>
</head>

<body>

  <div class="widget">

    <!-- 창 이동 전용 영역 -->
    <div class="drag-area"></div>

    <div class="bubble">
      <div class="status">SYSTEM READY</div>
      현재 기본 시스템이<br>
      정상적으로 작동하고 있어요.
    </div>

    <div class="panel" id="panel">
      <div class="panel-title">
        Factory Guide
      </div>

      <div id="statusRows">
        <div class="row">
          <span>System</span>
          <span class="ready">LOADING</span>
        </div>
      </div>

      <button class="close" onclick="closePanel()">
        닫기
      </button>
    </div>

    <div class="character-stage" id="characterStage">
      <img
        id="character"
        class="character"
        alt="Factory Guide"
        draggable="false"
      >
    </div>

  </div>

  <script>
    async function loadSystemStatus() {
      try {
        const response = await fetch(
          "file:///Users/juhyun/AI-Influencer-Factory/monitor-app/app/data/system-status.json"
        );

        const data = await response.json();
        const container = document.getElementById("statusRows");

        container.innerHTML = data.setupSteps.map(step => {
          const status = step.status;

          let className = "waiting";

          if (status === "READY") {
            className = "ready";
          } else if (status === "NEXT") {
            className = "next";
          }

          return `
            <div class="row">
              <span>${step.name}</span>
              <span class="${className}">${status}</span>
            </div>
          `;
        }).join("");

        if (data.updatedAt) {
          const updated = new Date(data.updatedAt);
          const time = updated.toLocaleTimeString("ko-KR", {
            hour: "2-digit",
            minute: "2-digit"
          });

          container.insertAdjacentHTML(
            "beforeend",
            `<div style="margin-top:10px;text-align:center;font-size:10px;color:#64748b;">
              마지막 업데이트 ${time}
            </div>`
          );
        }

      } catch (error) {
        console.error("System status load failed:", error);
      }
    }

    loadSystemStatus();

    const character = document.getElementById('character');

    async function loadCharacterConfig() {
      try {
        const response = await fetch(
          "file:///Users/juhyun/AI-Influencer-Factory/monitor-app/electron/character-config.json"
        );

        const config = await response.json();

        const rendererType = config.renderer?.type || "image";

    console.log("Character renderer:", rendererType);

    if (rendererType === "image") {
      character.src = config.image;
    }

    character.alt = config.name || "Character";

        if (config.width) {
          character.style.width = config.width + "px";
        }

        if (config.animation && config.animation.idleDuration) {
          character.style.animationDuration =
            config.animation.idleDuration + "s";
        }

        console.log("Character loaded:", config.name);

      } catch (error) {
        console.error("Character config load failed:", error);
      }
    }

    loadCharacterConfig();

    character.addEventListener('dragstart', function(event) {
      event.preventDefault();
    });

    const bubble = document.querySelector('.bubble');

    character.addEventListener('mousedown', function(event) {
      event.preventDefault();

      if (event.button === 0) {
        const isOpen = panel.classList.toggle('open');

        if (bubble) {
          bubble.style.display = isOpen ? 'none' : 'block';
        }
      }
    });

    function closePanel() {
      panel.classList.remove('open');

      if (bubble) {
        bubble.style.display = 'block';
      }
    }

    </script>

</body>
</html>
